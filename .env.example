# ==============================================================================
# SHINPO (進歩) — SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` to configure local PostgreSQL and backend services.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=shinpo
POSTGRES_USER=shinpo
POSTGRES_PASSWORD=shinpo_dev
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/shinpo

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security & Authentication (JWT)
# Minimum 256-bit secret key for HMAC-SHA256 signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_SECONDS=86400

# Sentinel & Focus Protection Daemon
SHINPO_DAEMON_PORT=9876
SHINPO_SHIELD_ENABLED=true

# AI Orchestrator / Gemini API (Optional for EONPAI Copilot)
GEMINI_API_KEY=

