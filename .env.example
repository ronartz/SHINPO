# ==============================================================================
# SHINPO (進歩) — OPTIONAL ENVIRONMENT CONFIGURATION
# SHINPO is a 100% local-first application. No external database or server
# is required. All data is encrypted locally with AES-256 SQLCipher.
# ==============================================================================

# Optional: Local Ollama Endpoint for EONPAI Conversational AI
# Defaults to http://127.0.0.1:11434 if Ollama is running locally.
OLLAMA_ORIGIN=http://127.0.0.1:11434

# Optional: Custom Server URL (for dev testing only)
# VITE_SHINPO_SERVER_URL=
