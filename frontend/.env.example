# ==============================================================================
# SHINPO (進歩) — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` or `.env.local` to customize local development settings.
# ==============================================================================

# Backend REST API Base URL
# Default in development: "" (uses Vite proxy /api -> http://localhost:8080)
# Desktop (Tauri) fallback: "http://localhost:8080"
# Production / Remote: "https://api.yourdomain.com"
VITE_SHINPO_SERVER_URL=

# WebSocket Base URL
# Default in development: "" (derived from window.location or server URL + /ws)
# Remote / Desktop override: "ws://localhost:8080/ws" or "wss://api.yourdomain.com/ws"
VITE_SHINPO_WS_URL=

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_V2_PREVIEW=true
VITE_ENABLE_DEV_MOCKS=false

