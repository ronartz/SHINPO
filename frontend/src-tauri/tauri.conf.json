{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SHINPO",
  "version": "1.0.0",
  "identifier": "com.shinpo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SHINPO — Personal Execution OS",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "nsis"],
    "category": "Utility",
    "shortDescription": "SHINPO Personal Execution Operating System",
    "longDescription": "SHINPO is a disciplined personal execution operating system integrating goals, scheduled focus sessions, native Shield distraction enforcement, and EONPAI AI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
