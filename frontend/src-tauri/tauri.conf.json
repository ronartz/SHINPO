{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SHINPO",
  "version": "1.0.0",
  "identifier": "com.shinpo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node ../scripts/prepare-desktop-bundle.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "SHINPO — Personal Execution OS",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "base-uri": "'self'",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self' asset: http://asset.localhost",
        "base-uri": "'self'",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "nsis"],
    "resources": {
      "target/bundle-input/*": "browser-companion/",
      "../../browser-extension/dist/chromium/*": "browser-companion/chromium/",
      "../../browser-extension/dist/firefox/*": "browser-companion/firefox/",
      "../../scripts/register-browser-companion.sh": "browser-companion/register-browser-companion.sh",
      "../../scripts/register-browser-companion.ps1": "browser-companion/register-browser-companion.ps1",
      "../../docs/Browser-Companion-Install.md": "browser-companion/Browser-Companion-Install.md"
    },
    "category": "Utility",
    "shortDescription": "SHINPO Personal Execution Operating System",
    "longDescription": "SHINPO combines goals, scheduled focus sessions, focus-aware browser policies, consent-based app observations, and the EONPAI assistant.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libssl3 | libssl3t64"]
      },
      "rpm": {
        "release": "1",
        "depends": ["openssl-libs"]
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
