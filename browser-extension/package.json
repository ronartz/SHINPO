{
  "name": "@shinpo/browser-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SHINPO contextual focus browser companion",
  "scripts": {
    "clean": "node scripts/build.mjs --clean",
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target chromium",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "package": "node scripts/package.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
